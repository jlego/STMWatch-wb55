{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/Debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "OpenOCD",
            "type": "shell",
            "command": "python3",
            "args": [
                "${workspaceFolder}/scripts/start_openocd.py"
            ],
            "problemMatcher": []
        },
        {
            "label": "OpenOCD + Build",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build Debug",
                "OpenOCD"
            ],
            "problemMatcher": []
        }
    ]
}